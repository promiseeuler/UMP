{
  "ump_socket": "/var/lib/ump/adapter.sock",
  "controller_base_url": "https://127.0.0.1:8443",
  "token_env": "UMP_VENDOR_CONTROLLER_TOKEN",
  "ca_file": "/etc/ump/vendor-controller-ca.pem",
  "client_certificate": "/etc/ump/vendor-controller-client.pem",
  "client_key": "/etc/ump/vendor-controller-client-key.pem",
  "allow_insecure_loopback": false,
  "read_only": false,
  "poll_interval_seconds": 0.1,
  "health_path": "/v1/health",
  "observation_path": "/v1/observations/current",
  "capabilities": {
    "org.ump.vendor.example.execute": {
      "path": "/v1/commands/execute",
      "cancel_path": "/v1/commands/cancel",
      "timeout_seconds": 30,
      "maximum_input_bytes": 65536
    }
  }
}
