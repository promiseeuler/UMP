<?xml version="1.0"?>
<package format="3">
  <name>ump_webots_demo</name>
  <version>0.1.0</version>
  <description>Webots and ROS 2 Jazzy visual warehouse demonstration for UMP.</description>
  <maintainer email="promiseeuler@users.noreply.github.com">Promise Euler</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ump_interfaces</exec_depend>
  <exec_depend>webots_ros2_driver</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
