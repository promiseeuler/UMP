  children [ Shape { appearance PBRAppearance { baseColor 0.22 0.24 0.25 roughness 0.9 } geometry Box { size 18 0.16 12 } } ]
  name "warehouse floor"
  boundingObject Box { size 18 0.16 12 }
}

