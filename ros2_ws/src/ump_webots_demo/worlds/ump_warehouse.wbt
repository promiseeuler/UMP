WorldInfo {
  basicTimeStep 32
  title "UMP Collaborative Warehouse"
  info [
    "Three manufacturer-neutral robots coordinate through UMP over ROS 2."
    "Route inspection, package transport, and shelf placement execute in order."
  ]
}
Viewpoint {
  orientation -0.38 0.88 0.28 1.42
  position 10 10 13
  follow "package-1"
}
TexturedBackground {}
TexturedBackgroundLight {}

Solid {
