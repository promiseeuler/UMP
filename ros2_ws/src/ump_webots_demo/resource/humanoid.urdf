<?xml version="1.0"?>
<robot name="UMP Humanoid">
  <webots>
    <device reference="gps" type="GPS"><ros><enabled>true</enabled><alwaysOn>true</alwaysOn></ros></device>
    <plugin type="ump_webots_demo.warehouse_driver.WarehouseRobotDriver">
      <capability>ump.material.carry/v1</capability>
      <role>package carrier</role>
      <packageDef>PACKAGE_1</packageDef>
    </plugin>
  </webots>
</robot>
