<?xml version="1.0"?>
<sdf version="1.10">
  <world name="ump_conformance">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.12 0.14 0.16 1</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><diffuse>0.32 0.35 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="robot_humanoid_proxy">
      <static>true</static>
      <pose>-3 0 0 0 0 0</pose>
      <link name="body">
        <visual name="torso">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry><box><size>0.55 0.3 0.75</size></box></geometry>
          <material><diffuse>0.15 0.55 0.85 1</diffuse></material>
        </visual>
        <visual name="head">
          <pose>0 0 1.82 0 0 0</pose>
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><diffuse>0.82 0.86 0.9 1</diffuse></material>
        </visual>
        <visual name="left_leg">
          <pose>0 0.17 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.85</length></cylinder></geometry>
          <material><diffuse>0.12 0.18 0.24 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.17 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.85</length></cylinder></geometry>
          <material><diffuse>0.12 0.18 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="robot_quadruped_proxy">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="body">
        <visual name="chassis">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>1.0 0.5 0.35</size></box></geometry>
          <material><diffuse>0.86 0.72 0.18 1</diffuse></material>
        </visual>
        <visual name="leg_fl"><pose>0.35 0.2 0.35 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry></visual>
        <visual name="leg_fr"><pose>0.35 -0.2 0.35 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry></visual>
        <visual name="leg_rl"><pose>-0.35 0.2 0.35 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry></visual>
        <visual name="leg_rr"><pose>-0.35 -0.2 0.35 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry></visual>
      </link>
    </model>

    <model name="robot_mobile_arm_proxy">
      <static>true</static>
      <pose>3 0 0 0 0 0</pose>
      <link name="body">
        <visual name="base">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><cylinder><radius>0.5</radius><length>0.45</length></cylinder></geometry>
          <material><diffuse>0.25 0.7 0.42 1</diffuse></material>
        </visual>
        <visual name="column">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.9</length></cylinder></geometry>
          <material><diffuse>0.15 0.2 0.24 1</diffuse></material>
        </visual>
        <visual name="arm">
          <pose>0.35 0 1.25 0 1.1 0</pose>
          <geometry><box><size>0.75 0.14 0.14</size></box></geometry>
          <material><diffuse>0.25 0.7 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
