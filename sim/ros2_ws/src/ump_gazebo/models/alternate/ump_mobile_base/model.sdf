<?xml version="1.0"?>
<sdf version="1.10">
  <model name="ump_mobile_base">
    <link name="base_link">
      <inertial><mass>18</mass><inertia><ixx>0.55</ixx><iyy>0.8</iyy><izz>1.0</izz></inertia></inertial>
      <collision name="body_collision"><geometry><cylinder><radius>0.43</radius><length>0.28</length></cylinder></geometry></collision>
      <visual name="body_visual"><geometry><cylinder><radius>0.43</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.12 0.62 0.54 1</diffuse></material></visual>
      <collision name="tray_collision"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.64 0.58 0.05</size></box></geometry></collision>
      <visual name="tray_visual"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.64 0.58 0.05</size></box></geometry><material><diffuse>0.9 0.9 0.92 1</diffuse></material></visual>
      <collision name="caster"><pose>-0.31 0 -0.24 0 0 0</pose><geometry><sphere><radius>0.07</radius></sphere></geometry><surface><friction><ode><mu>0.04</mu><mu2>0.04</mu2></ode></friction></surface></collision>
    </link>
    <link name="left_wheel">
      <pose relative_to="base_link">0 0.36 -0.12 1.5708 0 0</pose>
      <inertial><mass>1.4</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry></visual>
    </link>
    <link name="right_wheel">
      <pose relative_to="base_link">0 -0.36 -0.12 1.5708 0 0</pose>
      <inertial><mass>1.4</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.72</wheel_separation><wheel_radius>0.18</wheel_radius>
      <topic>/model/mobile_base/cmd_vel</topic><odom_topic>/model/mobile_base/odometry</odom_topic>
    </plugin>
  </model>
</sdf>
