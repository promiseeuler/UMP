{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ump.dev/schemas/ump-independent-review-v1.schema.json",
  "title": "UMP Independent Review Evidence Bundle",
  "type": "object",
  "required": ["protocol", "review_id", "review_type", "subject", "reviewer", "conducted_at_ms", "report_evidence", "independence_attestation", "findings", "conclusion"],
  "properties": {
    "protocol": {"const": "ump.independent-review/v1"},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "review_type": {"enum": ["security", "safety", "interoperability"]},
    "subject": {
      "type": "object",
      "required": ["repository", "repository_revision", "scope"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "maxLength": 1024},
        "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": ["name", "organization", "independent", "conflict_disclosure"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "organization": {"type": "string", "minLength": 1, "maxLength": 256},
        "independent": {"const": true},
        "conflict_disclosure": {"type": "string", "minLength": 1, "maxLength": 2048}
      },
      "additionalProperties": false
    },
    "conducted_at_ms": {"type": "integer", "minimum": 1},
    "report_evidence": {"$ref": "#/$defs/evidence"},
    "independence_attestation": {"$ref": "#/$defs/evidence"},
    "supporting_evidence": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidence"}},
    "findings": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/finding"}},
    "conclusion": {"enum": ["approved", "approved_with_conditions", "rejected"]},
    "notes": {"type": "string", "maxLength": 4096}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "title", "severity", "status"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
        "status": {"enum": ["open", "resolved", "accepted"]},
        "disposition_evidence": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    }
  }
}
