{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ump.dev/schema/simulated-qualification/v1",
  "type": "object",
  "required": ["profile", "generated_at", "repository_revision", "scope", "scenarios", "checks", "passed", "environment"],
  "properties": {
    "profile": {"const": "ump.simulated-qualification/v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {
      "type": "object",
      "required": ["environment", "qualification_substitute", "limitations"],
      "properties": {
        "environment": {"const": "simulation"},
        "qualification_substitute": {"const": false},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "scenarios": {"type": "object", "minProperties": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "passed", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "passed": {"type": "boolean"},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false
}
