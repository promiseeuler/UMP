{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ump.dev/schemas/ump-lan-evidence-v1.schema.json",
  "title": "UMP two-host LAN benchmark evidence",
  "type": "object",
  "required": [
    "protocol",
    "run_id",
    "conducted_at_ms",
    "network_description",
    "client_report",
    "server_report"
  ],
  "properties": {
    "protocol": { "const": "ump.lan-evidence/v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "conducted_at_ms": { "type": "integer", "minimum": 1 },
    "network_description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "client_report": { "$ref": "#/$defs/evidence" },
    "server_report": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
