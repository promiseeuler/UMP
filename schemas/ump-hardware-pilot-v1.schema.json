{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ump.dev/schemas/hardware-pilot-v1.schema.json",
  "title": "UMP Hardware Pilot Evidence Bundle",
  "type": "object",
  "required": [
    "protocol",
    "repository_revision",
    "pilot_id",
    "phase",
    "site",
    "supervisor",
    "conducted_at_ms",
    "participants",
    "safety_evidence"
  ],
  "properties": {
    "protocol": {"const": "ump.hardware-pilot/v1"},
    "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pilot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "phase": {"enum": ["read_only", "supervised_assignment"]},
    "site": {"type": "string", "minLength": 1, "maxLength": 512},
    "supervisor": {"type": "string", "minLength": 1, "maxLength": 256},
    "conducted_at_ms": {"type": "integer", "minimum": 0},
    "participants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/participant"}
    },
    "safety_evidence": {
      "type": "object",
      "properties": {
        "adapter_safety_review": {"$ref": "#/$defs/evidence"},
        "bounded_work_area": {"$ref": "#/$defs/evidence"},
        "emergency_stop_test": {"$ref": "#/$defs/evidence"},
        "operator_approval": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string", "maxLength": 4096}
  },
  "allOf": [
    {
      "if": {
        "properties": {"phase": {"const": "supervised_assignment"}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "safety_evidence": {
            "required": [
              "adapter_safety_review",
              "bounded_work_area",
              "emergency_stop_test",
              "operator_approval"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "required": [
        "robot_id",
        "deployment",
        "adapter_id",
        "conformance_evidence"
      ],
      "properties": {
        "robot_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "deployment": {"enum": ["physical", "simulation"]},
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "conformance_evidence": {"$ref": "#/$defs/evidence"},
        "assignment_evidence": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    }
  }
}
