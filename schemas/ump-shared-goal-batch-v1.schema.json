{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ump.dev/schemas/ump-shared-goal-batch-v1.schema.json",
  "title": "UMP Shared Goal Batch",
  "type": "array",
  "minItems": 1,
  "maxItems": 256,
  "items": {"$ref": "#/$defs/goal"},
  "$defs": {
    "goal": {
      "type": "object",
      "required": ["goal_id", "description", "participant_ids"],
      "properties": {
        "goal_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 4096},
        "participant_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "constraints": {"type": "object", "default": {}},
        "deadline_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
